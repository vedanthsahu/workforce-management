{
  "name": "efacility-chatbot-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "start": "next dev",
    "build": "next build",
    "build:prod": "next build",
    "test:responsive": "TMPDIR=/tmp PLAYWRIGHT_TRANSFORM_CACHE_DIR=/tmp/efacility-pw-transform-cache playwright test -c playwright.config.ts",
    "test:responsive:validation": "TMPDIR=/tmp PLAYWRIGHT_TRANSFORM_CACHE_DIR=/tmp/efacility-pw-transform-cache PLAYWRIGHT_HTML_REPORT=/validation-results/playwright-report PLAYWRIGHT_JSON_REPORT=/validation-results/playwright-responsive-results.json playwright test -c playwright.config.ts",
    "test:responsive:headed": "TMPDIR=/tmp PLAYWRIGHT_TRANSFORM_CACHE_DIR=/tmp/efacility-pw-transform-cache playwright test -c playwright.config.ts --headed"
  },
  "private": true,
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "~5.5.4"
  }
}

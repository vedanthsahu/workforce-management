DATABASE_URL=postgresql+asyncpg://efacility:efacility123@localhost:5432/efacility_chatbot
SYNC_DATABASE_URL=postgresql://efacility:efacility123@localhost:5432/efacility_chatbot
APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
DEFAULT_TENANT_ID=3
SESSION_TTL_MINUTES=30
ALLOW_MULTIPLE_SEATS=false
MY_BOOKINGS_MAX_RESULTS=7
PAST_BOOKINGS_PAGE_SIZE=5
ENABLE_FREE_TEXT=true
ENABLE_VECTOR_INTENT=true
ENABLE_TELEMETRY=true
ENABLE_QUICK_BOOK_EXACT_SEAT=true
ENABLE_BOOKING_ACTION_CONFIRMATION=true
ENABLE_REDIS_MEMORY=true
REDIS_URL=redis://localhost:6379/0
ENABLE_ELK_CONVERSATION_LOGS=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_CONVERSATION_INDEX=logs-efacility-chatbot-conversations-default
ELASTICSEARCH_TIMEOUT_SECONDS=2
ADMIN_API_TOKEN=

ENABLE_SEAT_BACKEND_API=true
SEAT_BACKEND_API_URL=http://host.docker.internal:8000
MAIN_APP_JWT_SECRET=use-the-same-value-as-the-main-app-JWT_SECRET
MAIN_APP_JWT_ALGORITHM=HS256
SEAT_BACKEND_TRUST_ENV=false
# Browser chat uses a short-lived token issued by the authenticated SeatBook
# application. These values remain only for legacy non-browser channels.
SEAT_BACKEND_ACCESS_TOKEN=
SEAT_BACKEND_REFRESH_TOKEN=
SEAT_BACKEND_SESSION_TOKEN=
# Legacy fallback: combined browser Cookie header.
SEAT_BACKEND_AUTH_COOKIE=
# Refresh before the 15-minute auth window expires.
SEAT_BACKEND_REFRESH_INTERVAL_SECONDS=840
SEAT_BACKEND_TIMEOUT_SECONDS=10

WHATSAPP_ENABLED=true
WHATSAPP_VERIFY_TOKEN=efacility_chatbot_verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_USER_MAPPINGS=9876543210:Example User
WHATSAPP_SEND_MAX_RETRIES=3
WHATSAPP_RETRY_BACKOFF_SECONDS=0.75
WHATSAPP_MESSAGE_DEDUPE_TTL_SECONDS=86400
WHATSAPP_USE_FLOWS=false
WHATSAPP_BOOKING_FLOW_ID=
WHATSAPP_BOOKING_FLOW_SCREEN=BOOKING_FORM
WHATSAPP_BOOKING_FLOW_CTA=Open booking form

NGROK_AUTHTOKEN=
